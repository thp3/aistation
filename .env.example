# Only one administrator; account and password are NOT stored in SQLite.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# The installer generates random secrets for these.
SESSION_SECRET=replace-with-a-random-hex-secret
DATA_ENCRYPTION_KEY=replace-with-a-different-random-hex-secret
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
SESSION_DAYS=7
UPSTREAM_IDLE_TIMEOUT_MS=90000
UPSTREAM_MAX_TIMEOUT_MS=600000

# Optional npm run dev API target; defaults to http://127.0.0.1:${PORT}.
# DEV_API_TARGET=http://127.0.0.1:3000
